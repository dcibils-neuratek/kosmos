{"nodes": [{"id": "tools_test_page_layout_test_page", "label": "Browser layout test page", "file_type": "document", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exists so that a screenshot of the browser proves something: every block on it is one the renderer handles differently, so a picture shows at a glance which are working and which are not."}, {"id": "tools_test_page_heading_scale", "label": "Headings step down", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "h1 at twenty-eight pixels, h2 at twenty-two, both bold with a rule underneath; h3 shares eighteen with everything below it, because a document that needs six distinct heading sizes is a document with a structure problem."}, {"id": "tools_test_page_utf8_text", "label": "Accented Latin, on purpose", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The text path decodes UTF-8 and rasterises a glyph the first time it is asked for, so a row of boxes here would mean neither of those is true. The paragraph face is IBM Plex Sans at sixteen pixels."}, {"id": "tools_test_page_shared_baseline", "label": "Mixed inline faces on one shared baseline", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bold, italic and monospace sit on one shared baseline rather than a shared top edge, which is the arithmetic that stops mixed faces looking subtly broken."}, {"id": "tools_test_page_list_markers", "label": "List indent and hanging indent", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Twenty-four pixels with a marker; the second line of a long item lines up under the first rather than under the margin. The marker is a disc for every item, which is wrong for an ol - list-style comes from the cascade, and the cascade is not consulted here yet."}, {"id": "tools_test_page_blockquote", "label": "Blockquote - three signals for one idea", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Italic, indented by thirty-two pixels, and inked a little lighter than the body."}, {"id": "tools_test_page_pre_block", "label": "A monospace block that keeps its spaces", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "It works because a box knows which block it belongs to."}, {"id": "tools_test_page_no_box_model", "label": "No box model and no colour from the cascade", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The stylesheet at the top of the file parses and nothing on the page is drawn from it; faces are chosen by tag. The page says so rather than pretending otherwise."}, {"id": "tools_test_page_scroll_by_blit", "label": "Lay out once into a tall surface, scroll by blitting", "file_type": "rationale", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The document is laid out once when it arrives; a keypress changes which row of that surface is copied to the top of the window - one blit and no arithmetic anybody can get wrong. Laying out on every scroll would mean breaking two thousand words and drawing several thousand glyphs sixty times a second for a picture differing by forty pixels: not a slow implementation of scrolling but the wrong shape, and the same wrong shape the PDF viewer avoided."}, {"id": "tools_test_page_surface_ceiling", "label": "Sixteen megabytes of paper", "file_type": "concept", "source_file": "tools/test_page.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "About seven screenfuls at this width. A taller document is cut off, and the status line says by how much rather than letting the page simply stop."}], "edges": [{"source": "tools_test_page_layout_test_page", "target": "tools_test_linked_the_other_page", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_layout_test_page", "target": "tools_test_page_heading_scale", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_layout_test_page", "target": "tools_test_page_utf8_text", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_layout_test_page", "target": "tools_test_page_shared_baseline", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_layout_test_page", "target": "tools_test_page_list_markers", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_layout_test_page", "target": "tools_test_page_blockquote", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_layout_test_page", "target": "tools_test_page_pre_block", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_no_box_model", "target": "tools_test_page_list_markers", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_no_box_model", "target": "docs_roadmap_box_model", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_scroll_by_blit", "target": "docs_glossary_surface", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_scroll_by_blit", "target": "docs_glossary_blit", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_scroll_by_blit", "target": "tools_test_page_surface_ceiling", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_scroll_by_blit", "target": "docs_glossary_backbuffer", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "tools/test_page.html", "source_location": null, "weight": 1.0}, {"source": "tools_test_page_utf8_text", "target": "docs_roadmap_graphics_built", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.8