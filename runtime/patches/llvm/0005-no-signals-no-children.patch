+//===- Kosmos/Signals.inc - Signals, on a system without them ---*- C++ -*-===//
+//
+// Kosmos. Copyright (c) 2026 Diego Cibils. MIT; see LICENSE.
+//
+// A Kosmos process receives no signals (`CLAUDE.md`, *Compatibility inside
+// a process yes, at system level never*): nothing interrupts it, nothing
+// asks it for information, no pipe breaks under it, and a fault ends it
+// with Nebula saying where. So nothing here is ever delivered, and what
+// LLVM asks of this file is kept only where it means something without
+// one:
+//
+// - a callback added with `AddSignalHandler` is kept, as Unix keeps it,
+//   because `RunSignalHandlers` - which LLVM's fatal-error path calls - is
+//   in `Signals.cpp` and runs them;
+// - files to remove on a signal are remembered and removed when the
+//   interrupt handlers run, which `report_fatal_error` does too;
+// - a stack trace is not printed: the Debug Kit names functions from the
+//   addresses Nebula reports when a process stops (`docs/debug.md`).
+//
+//===----------------------------------------------------------------------===//
+
+#include "llvm/Support/ExitCodes.h"
+#include "llvm/Support/FileSystem.h"
+#include <mutex>
+#include <string>
+#include <vector>
+
+using namespace llvm;
+
+namespace {
+std::mutex FilesLock;
+std::vector<std::string> &filesToRemove() {
+  static std::vector<std::string> Files;
+  return Files;
+}
+} // namespace
+
+void sys::unregisterHandlers() {}
+
+void sys::CleanupOnSignal(uintptr_t Context) { sys::RunInterruptHandlers(); }
+
+void sys::RunInterruptHandlers() {
+  std::lock_guard<std::mutex> Guard(FilesLock);
+  for (const std::string &File : filesToRemove())
+    sys::fs::remove(File);
+  filesToRemove().clear();
+}
+
+void llvm::sys::SetInterruptFunction(void (*IF)()) {}
+
+void llvm::sys::SetInfoSignalFunction(void (*Handler)()) {}
+
+void llvm::sys::SetOneShotPipeSignalFunction(void (*Handler)()) {}
+
+void llvm::sys::DefaultOneShotPipeSignalHandler() { exit(EX_IOERR); }
+
+bool llvm::sys::RemoveFileOnSignal(StringRef Filename, std::string *ErrMsg) {
+  std::lock_guard<std::mutex> Guard(FilesLock);
+  filesToRemove().push_back(Filename.str());
+  return false;
+}
+
+void llvm::sys::DontRemoveFileOnSignal(StringRef Filename) {
+  std::lock_guard<std::mutex> Guard(FilesLock);
+  std::vector<std::string> &Files = filesToRemove();
+  for (auto I = Files.rbegin(), E = Files.rend(); I != E; ++I) {
+    if (*I == Filename) {
+      Files.erase(std::next(I).base());
+      return;
+    }
+  }
+}
+
+void llvm::sys::AddSignalHandler(sys::SignalHandlerCallback FnPtr, void *Cookie,
+                                 bool NeedsPOSIXUtilitySignalHandling) {
+  insertSignalHandler(FnPtr, Cookie);
+}
+
+void llvm::sys::PrintStackTrace(raw_ostream &OS, int Depth) {}
+
+void llvm::sys::DisableSystemDialogsOnCrash() {}
+
+void llvm::sys::PrintStackTraceOnErrorSignal(StringRef Argv0,
+                                             bool DisableCrashReporting) {}
+
+// What `Signals.cpp`'s symbolizer asks of a platform: the modules the
+// addresses are in, and the markup context. Neither exists here - an image
+// is not a file, and there is no symbolizer to run - so both say no.
+static bool findModulesAndOffsets(void **StackTrace, int Depth,
+                                  const char **Modules, intptr_t *Offsets,
+                                  const char *MainExecutableName,
+                                  StringSaver &StrPool) {
+  return false;
+}
+
+static bool printMarkupContext(raw_ostream &OS, const char *MainExecutableName) {
+  return false;
+}
