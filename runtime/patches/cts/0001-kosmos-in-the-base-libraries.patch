diff -ruN a/framework/delibs/deutil/deProcess.c b/framework/delibs/deutil/deProcess.c
--- a/framework/delibs/deutil/deProcess.c	2026-11-19 15:29:28.635914162 -0300
+++ b/framework/delibs/deutil/deProcess.c	2026-11-19 15:29:28.636208693 -0300
@@ -25,7 +25,109 @@
 #include "deMemory.h"
 #include "deString.h"
 
-#if (DE_OS == DE_OS_UNIX) || (DE_OS == DE_OS_OSX) || (DE_OS == DE_OS_IOS) || (DE_OS == DE_OS_ANDROID) || \
+#if defined(__kosmos__)
+
+/* A process does not start another by a command line here, and nothing in
+ * the Vulkan suite run on Kosmos asks one to: every call says so. */
+
+#include "deMemory.h"
+
+struct deProcess_s
+{
+    int unused;
+};
+
+deProcess *deProcess_create(void)
+{
+    return (deProcess *)deCalloc(sizeof(deProcess));
+}
+
+void deProcess_destroy(deProcess *process)
+{
+    deFree(process);
+}
+
+bool deProcess_start(deProcess *process, const char *commandLine, const char *workingDirectory)
+{
+    DE_UNREF(process);
+    DE_UNREF(commandLine);
+    DE_UNREF(workingDirectory);
+    return false;
+}
+
+bool deProcess_isRunning(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+bool deProcess_waitForFinish(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+const char *deProcess_getLastError(const deProcess *process)
+{
+    DE_UNREF(process);
+    return "Kosmos does not start a process by its command line";
+}
+
+int deProcess_getExitCode(const deProcess *process)
+{
+    DE_UNREF(process);
+    return -1;
+}
+
+bool deProcess_terminate(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+bool deProcess_kill(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+deFile *deProcess_getStdIn(deProcess *process)
+{
+    DE_UNREF(process);
+    return NULL;
+}
+
+deFile *deProcess_getStdOut(deProcess *process)
+{
+    DE_UNREF(process);
+    return NULL;
+}
+
+deFile *deProcess_getStdErr(deProcess *process)
+{
+    DE_UNREF(process);
+    return NULL;
+}
+
+bool deProcess_closeStdIn(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+bool deProcess_closeStdOut(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+bool deProcess_closeStdErr(deProcess *process)
+{
+    DE_UNREF(process);
+    return false;
+}
+
+#elif (DE_OS == DE_OS_UNIX) || (DE_OS == DE_OS_OSX) || (DE_OS == DE_OS_IOS) || (DE_OS == DE_OS_ANDROID) || \
     (DE_OS == DE_OS_SYMBIAN) || (DE_OS == DE_OS_QNX)
 
 #include "deCommandLine.h"
