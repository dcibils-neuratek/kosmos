+#if OS(KOSMOS)
+// **The pool on Kosmos** (Kosmos docs/jit.md): one region, its pages given as
+// they are first touched, mapped twice (WTF's `kosmosMakeJITPool`) - read
+// and execute where the code runs, which is the pool JavaScriptCore knows,
+// and read and write at an address only the writer below holds. Nebula never maps a page writable
+// and executable at one address, so this is the only way code is made here:
+// every write into the pool is `performJITMemcpy`'s, which the separated
+// heap sends through `kosmosWriteToJITRegion`.
+static void kosmosWriteToJITRegion(off_t offset, const void* data, size_t dataSize)
+{
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+    // A repatch of a live jump or pointer is one aligned store, as it is
+    // when the pool is written in place.
+    memcpyAtomicIfPossible(reinterpret_cast<void*>(g_jscConfig.startOfFixedWritableMemoryPool + offset), data, dataSize);
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_END
+    kosmosJITPoolWrote(dataSize);
+}
+
+static PageReservation kosmosReserveJITPool(size_t size)
+{
+    KosmosJITPool pool = kosmosMakeJITPool(size, executablePageSize());
+    if (!pool.executable)
+        return { };
+    g_jscConfig.startOfFixedWritableMemoryPool = pool.writable;
+    g_jscConfig.jitWriteSeparateHeaps = reinterpret_cast<JITWriteSeparateHeapsFunction>(
+        tagCFunctionPtr<JITThunkPtrTag>(&kosmosWriteToJITRegion));
+    return PageReservation::adoptMapped(pool.executable, size);
+}
+#endif
+
 WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
 
