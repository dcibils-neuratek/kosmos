+
+// One rectangle of the other buffer copied into the one being drawn, a row
+// at a time - from `from` before it in the other, for a scroll the other
+// has not had.
+void BackingStore::kosmosCopy(const WebCore::IntRect& rect, const WebCore::IntSize& from)
+{
+    WebCore::IntRect view(WebCore::IntPoint(), m_size);
+    WebCore::IntRect r = intersection(rect, view);
+    WebCore::IntRect source = r;
+    source.move(-from);
+    source.intersect(view);
+    source.move(from);
+    r.intersect(source);
+    if (r.isEmpty())
+        return;
+    auto* base = static_cast<uint8_t*>(m_kosmosAt);
+    uint8_t* to = base + m_kosmosDraw * m_kosmosBytes;
+    const uint8_t* other = base + (1 - m_kosmosDraw) * m_kosmosBytes;
+    size_t at = static_cast<size_t>(r.y()) * m_kosmosPitch + static_cast<size_t>(r.x()) * 4;
+    size_t was = static_cast<size_t>(r.y() - from.height()) * m_kosmosPitch + static_cast<size_t>(r.x() - from.width()) * 4;
+    size_t bytes = static_cast<size_t>(r.width()) * 4;
+    for (int row = 0; row < r.height(); ++row, at += m_kosmosPitch, was += m_kosmosPitch)
+        memcpy(to + at, other + was, bytes);
+}
+
+// **The catching up and the update's own scroll as one** (`webkit.md`
+// Fast 1c): the buffer behind owes the scroll the other had and now gets
+// another, so it is moved once by the two added together, and what it owes
+// of the other's rectangles is copied from the other shifted by the new
+// one - rather than moved twice, the whole view each time. Owing the whole,
+// it is the other copied shifted, which is one pass too. False when the
+// two scrolls are of different rectangles: caught up, then scrolled, as
+// before.
+bool BackingStore::kosmosCatchUpScrolled(const WebCore::IntRect& scrollRect, const WebCore::IntSize& scrollOffset)
+{
+    auto& owed = m_kosmosOwed[m_kosmosDraw];
+    WebCore::IntRect view(WebCore::IntPoint(), m_size);
+
+    if (owed.whole) {
+        WebCore::Region outside(view);
+        outside.subtract(scrollRect);
+        for (const auto& rect : outside.rects())
+            kosmosCopy(rect);
+        WebCore::IntRect kept = scrollRect;
+        kept.move(scrollOffset);
+        kept.intersect(scrollRect);
+        kosmosCopy(kept, scrollOffset);
+        owed = KosmosOwed { };
+        return true;
+    }
+
+    if (!owed.scroll.isZero() && owed.scrollRect != scrollRect)
+        return false;
+
+    scroll(scrollRect, owed.scroll + scrollOffset);
+    for (const auto& rect : owed.region.rects()) {
+        WebCore::Region outside(rect);
+        outside.subtract(scrollRect);
+        for (const auto& part : outside.rects())
+            kosmosCopy(part);
+        WebCore::IntRect inside = intersection(rect, scrollRect);
+        inside.move(scrollOffset);
+        inside.intersect(scrollRect);
+        kosmosCopy(inside, scrollOffset);
+    }
+    owed = KosmosOwed { };
+    return true;
+}
+
+// The buffer about to be drawn made the other's picture again: what it
+// owes, paid. The other is the one on the screen, which nothing writes.
+void BackingStore::kosmosCatchUp()
+{
+    auto& owed = m_kosmosOwed[m_kosmosDraw];
+    if (owed.whole)
+        kosmosCopy(WebCore::IntRect(WebCore::IntPoint(), m_size));
+    else {
+        if (!owed.scroll.isZero())
+            scroll(owed.scrollRect, owed.scroll);
+        for (const auto& rect : owed.region.rects())
+            kosmosCopy(rect);
+    }
+    owed = KosmosOwed { };
+}
+
+// What was just done to the buffer being drawn, added to what the other
+// owes: a scroll joins the scrolls it owes already, which moves the region
+// it owes with it, and the rectangles painted - with any the scroll left
+// behind - join that region. A second scroll of another rectangle, or a
+// region of most of the view, and it owes the whole: one copy, rather than
+// arithmetic that buys nothing.
+void BackingStore::kosmosOwe(const WebCore::IntRect& scrollRect, const WebCore::IntSize& scrollOffset, const Vector<WebCore::IntRect>& rects)
+{
+    auto& owed = m_kosmosOwed[1 - m_kosmosDraw];
+    if (owed.whole || kosmosStoreForgets)
+        return;
+
+    if (!scrollOffset.isZero()) {
+        if (!owed.scroll.isZero() && owed.scrollRect != scrollRect) {
+            owed = KosmosOwed { true, { }, { }, { } };
+            return;
+        }
+        owed.scrollRect = scrollRect;
+        owed.scroll += scrollOffset;
+
+        WebCore::Region moved;
+        for (const auto& rect : owed.region.rects()) {
+            WebCore::IntRect inside = intersection(rect, scrollRect);
+            WebCore::Region outside(rect);
+            outside.subtract(scrollRect);
+            moved.unite(outside);
+            inside.move(scrollOffset);
+            inside.intersect(scrollRect);
+            moved.unite(inside);
+        }
+        WebCore::Region exposed(scrollRect);
+        WebCore::IntRect kept = scrollRect;
+        kept.move(scrollOffset);
+        exposed.subtract(kept);
+        moved.unite(exposed);
+        owed.region = WTF::move(moved);
+    }
+
+    for (const auto& rect : rects)
+        owed.region.unite(rect);
+
+    if (owed.region.totalArea() * 10 > static_cast<uint64_t>(m_size.width()) * m_size.height() * 6)
+        owed = KosmosOwed { true, { }, { }, { } };
+}
+
+bool BackingStore::kosmosShow(KosmosShown& out, bool everything)
+{
+    if (!m_kosmosAt)
+        return false;
+
+    // All of it, from the buffer being drawn made whole first: a window
+    // manager shown this store for the first time has nothing of it.
+    if (everything) {
+        kosmosCatchUp();
+        m_kosmosChanged = WebCore::IntRect(WebCore::IntPoint(), m_size);
+    }
+
+    if (m_kosmosChanged.isEmpty())
+        return false;
+
+    out.region = m_kosmosRegion;
+    out.width = m_size.width();
+    out.height = m_size.height();
+    out.pitch = m_kosmosPitch;
+    out.bytes = m_kosmosBytes;
+    out.buffer = m_kosmosDraw + 1;
+    out.damage = m_kosmosChanged.bounds();
+    out.generation = m_kosmosGeneration;
+
+    m_kosmosChanged = WebCore::Region();
+    m_kosmosDraw = 1 - m_kosmosDraw;
+    m_surface = m_kosmosBuffers[m_kosmosDraw];
+    return true;
+}
