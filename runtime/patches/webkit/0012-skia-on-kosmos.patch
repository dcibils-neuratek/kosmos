+// Kosmos's libc++ is built without localisation, and so without streams;
+// in the C locale they print what printf's %g prints and read what strtod
+// reads, which is what these are then written with (docs/w5.md W5e).
+#if (defined(_LIBCPP_HAS_LOCALIZATION) && !_LIBCPP_HAS_LOCALIZATION)
+#define SKSL_NO_STREAMS 1
+#else
+#define SKSL_NO_STREAMS 0
+#include <locale>
+#include <sstream>
+#endif
+
+#if SKSL_NO_STREAMS
+template <typename RoundtripType, int kFullPrecision>
+static std::string to_string_impl(RoundtripType value) {
+    char buffer[64];
+    snprintf(buffer, sizeof(buffer), "%.*g", 7, (double)value);
+    std::string text = buffer;
+
+    double roundtripped = strtod(buffer, nullptr);
+    if (value != (RoundtripType)roundtripped && std::isfinite(value)) {
+        snprintf(buffer, sizeof(buffer), "%.*g", kFullPrecision, (double)value);
+        text = buffer;
+    }
+
+    // We need to emit a decimal point to distinguish floats from ints.
+    if (!skstd::contains(text, '.') && !skstd::contains(text, 'e')) {
+        text += ".0";
+    }
+
+    return text;
+}
+#else
