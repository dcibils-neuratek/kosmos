 void DebugTracePriv::setSource(const std::string& source) {
     fSource.clear();
+#if (defined(_LIBCPP_HAS_LOCALIZATION) && !_LIBCPP_HAS_LOCALIZATION)
+    // The lines a stream's getline gives, without streams (docs/w5.md W5e):
+    // one more than there are newlines, the last empty after a final one.
+    size_t start = 0;
+    for (;;) {
+        size_t end = source.find('\n', start);
+        if (end == std::string::npos) {
+            fSource.push_back(source.substr(start));
+            break;
+        }
+        fSource.push_back(source.substr(start, end - start));
+        start = end + 1;
+    }
+#else
     std::stringstream stream{source};
     while (stream.good()) {
         fSource.push_back({});
         std::getline(stream, fSource.back(), '\n');
     }
+#endif
 }
 
