 String WebInspectorUI::localizedStringsURL() const
 {
+#if PLATFORM(KOSMOS)
+    // Beside the front end's own page: its folder on the disk, wherever
+    // the application put it (`WKInspectorSetResourcesKosmos`).
+    URL page = m_page->mainWebFrame().url();
+    return URL(page, "Localizations/en.lproj/localizedStrings.js"_s).string();
+#else
     notImplemented();
     return emptyString();
+#endif
 }
 
