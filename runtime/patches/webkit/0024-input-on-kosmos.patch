@@ -87,6 +87,11 @@
 #endif
 #elif PLATFORM(PLAYSTATION)
     NativeWebMouseEvent(struct wpe_input_pointer_event*, float deviceScaleFactor, WebMouseEventSyntheticClickType = WebMouseEventSyntheticClickType::NoTap);
+#elif PLATFORM(KOSMOS)
+    // Kosmos's pointer, made into WebKit's event by the UI process's C API
+    // (`WKPageKosmos.cpp`): there is no toolkit event behind it to keep.
+    explicit NativeWebMouseEvent(const WebMouseEvent& event)
+        : WebMouseEvent(event) { }
 #elif PLATFORM(WIN)
     NativeWebMouseEvent(HWND, UINT message, WPARAM, LPARAM, bool, float deviceScaleFactor);
 #endif
