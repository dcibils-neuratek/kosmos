Input on Kosmos: the pointer, the wheel and keys (docs/w7.md W7c).

Each port makes its toolkit's event into WebKit's through a constructor
of NativeWebMouseEvent, NativeWebWheelEvent and NativeWebKeyboardEvent.
Kosmos has no toolkit event: the window manager's pointer and keys reach the
UI process's C API (WKPageKosmos.cpp), which builds WebKit's own event
and hands it over through these.

diff -ruN a/Source/WebKit/Shared/NativeWebKeyboardEvent.h b/Source/WebKit/Shared/NativeWebKeyboardEvent.h
--- a/Source/WebKit/Shared/NativeWebKeyboardEvent.h	2026-11-14 16:54:45.466631355 -0300
+++ b/Source/WebKit/Shared/NativeWebKeyboardEvent.h	2026-11-14 16:54:45.478925771 -0300
@@ -90,6 +90,10 @@
 #elif PLATFORM(PLAYSTATION)
     enum class HandledByInputMethod : bool { No, Yes };
     NativeWebKeyboardEvent(struct wpe_input_keyboard_event*, const String&, bool isAutoRepeat, HandledByInputMethod, std::optional<Vector<WebCore::CompositionUnderline>>&&, std::optional<EditingRange>&&);
+#elif PLATFORM(KOSMOS)
+    // A key from the window manager, as WebKit's event (`WKPageKosmos.cpp`).
+    explicit NativeWebKeyboardEvent(const WebKeyboardEvent& event)
+        : WebKeyboardEvent(event) { }
 #elif PLATFORM(WIN)
     NativeWebKeyboardEvent(HWND, UINT message, WPARAM, LPARAM, Vector<MSG>&& pendingCharEvents);
 #endif
diff -ruN a/Source/WebKit/Shared/NativeWebMouseEvent.h b/Source/WebKit/Shared/NativeWebMouseEvent.h
