+// Kosmos: a page and its trackers set cookies by the hundred, and each was
+// a transaction of its own - SQLite's journal made, written, fsynced and
+// removed, and the database fsynced - 522 disk commits for one load of The
+// Verge (Kosmos testing.md 18.836). WAL, which makes that cheap elsewhere,
+// needs memory shared between processes, which SQLite's dotfile VFS here
+// has not got. So the changes go into one transaction, committed a second
+// after its first change and whenever the database closes - as Chromium
+// keeps its cookies, writing them out every so often. A crash loses the
+// last second of cookies, never the database.
+void CookieJarDB::beginBatch()
+{
+    if (m_batchOpen || isOnMemory() || !m_database.isOpen())
+        return;
+
+    if (!m_database.executeCommand("BEGIN"_s))
+        return;
+
+    m_batchOpen = true;
+    m_commitTimer.startOneShot(1_s);
+}
+
+void CookieJarDB::commitBatch()
+{
+    if (!m_batchOpen)
+        return;
+
+    m_batchOpen = false;
+    m_commitTimer.stop();
+
+    if (m_database.isOpen() && !m_database.executeCommand("COMMIT"_s))
+        LOG_ERROR("Unable to commit the cookies (%d %s)", m_database.lastError(), m_database.lastErrorMsg());
+}
+
