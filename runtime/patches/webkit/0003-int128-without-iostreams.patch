Int128 without iostreams (docs/w4.md W4c). WTF's 128-bit integers can be
printed to a std::ostream, and that needs iostreams, which a libc++ built
without localisation does not have - Kosmos's (runtime/cxx/runtimes.cmake).
WebKit prints them through its own PrintStream, which is untouched; only
the std::ostream operators and their formatter are left out, and only
where the library says it has no localisation.

--- a/Source/WTF/wtf/Int128.h
+++ b/Source/WTF/wtf/Int128.h
@@ -41,6 +41,14 @@
 #include <wtf/ExportMacros.h>
 #include <wtf/Platform.h>
 
+// Printing to a std::ostream needs iostreams, which a libc++ built
+// without localisation does not have (Kosmos's: runtime/cxx/runtimes.cmake).
+#if !defined(_LIBCPP_VERSION) || _LIBCPP_HAS_LOCALIZATION
+#define WTF_INT128_HAS_STREAMS 1
+#else
+#define WTF_INT128_HAS_STREAMS 0
+#endif
+
 #if COMPILER(MSVC)
 // In very old versions of MSVC and when the /Zc:wchar_t flag is off, wchar_t is
 // a typedef for unsigned short.  Otherwise wchar_t is mapped to the __wchar_t
@@ -207,7 +215,9 @@
 };
 
 // allow UInt128Impl to be logged
+#if WTF_INT128_HAS_STREAMS
 WTF_EXPORT_PRIVATE std::ostream& operator<<(std::ostream& os, UInt128Impl v);
+#endif
 
 // TODO(strel) add operator>>(std::istream&, UInt128Impl)
 
@@ -406,7 +416,9 @@
 #endif  // byte order
 };
 
+#if WTF_INT128_HAS_STREAMS
 WTF_EXPORT_PRIVATE std::ostream& operator<<(std::ostream& os, Int128Impl v);
+#endif
 
 // TODO(absl-team) add operator>>(std::istream&, Int128Impl)
 
