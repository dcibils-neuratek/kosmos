+++ b/Source/WebKit/WebProcess/WebPage/CoordinatedGraphics/DrawingAreaCoordinatedGraphics.cpp	2026-11-17 10:28:26.255108827 -0300
@@ -575,7 +575,14 @@
         return;
 
     UpdateInfo updateInfo;
+#if PLATFORM(KOSMOS)
+    {
+        SetForScope reusing(m_kosmosReusing, true);
+        display(updateInfo);
+    }
+#else
     display(updateInfo);
+#endif
 
     if (updateInfo.updateRectBounds.isEmpty())
         return;
@@ -649,7 +656,24 @@
     IntSize bitmapSize = bounds.size();
     float deviceScaleFactor = webPage->corePage()->deviceScaleFactor();
     bitmapSize.scale(deviceScaleFactor);
+#if PLATFORM(KOSMOS)
+    // **The region before, used again** (testing.md 18.856): a picture the
+    // size of the bounds was a region made afresh for every update - 3.3 MB
+    // and 0.7 ms on the M700 for a scrolled frame, whose bounds are the
+    // view's because the scrollbar runs down its edge. Only the dirty
+    // rectangles are painted and only they are taken in, so the last
+    // update's picture serves for the next of its size once the UI process
+    // has said it is done with it, which is what `display()` waits for.
+    bool reusable = m_kosmosReusing && !m_isWaitingForDidUpdate;
+    RefPtr<ShareableBitmap> bitmap;
+    if (reusable && m_kosmosLastUpdate && m_kosmosLastUpdate->size() == bitmapSize)
+        bitmap = m_kosmosLastUpdate;
+    else
+        bitmap = ShareableBitmap::create({ bitmapSize });
+    m_kosmosLastUpdate = reusable ? bitmap : nullptr;
+#else
     auto bitmap = ShareableBitmap::create({ bitmapSize });
+#endif
     if (!bitmap)
         return;
 
