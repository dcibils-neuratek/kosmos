No dynamic loading and no signals (docs/gpu3d.md G1; CLAUDE.md,
*Compatibility inside a process yes, at system level never*). Nothing
on Kosmos is linked dynamically, so util_dl's functions open nothing,
as on a system Mesa does not know - every driver is in the image. And a
Kosmos process receives no signals, so a new thread is not started with
them masked; nor is there a clock of one thread's processor time, so
util_thread_get_time_nano says 0, as it does on Apple's systems.

--- a/src/util/u_dl.c
+++ b/src/util/u_dl.c
@@ -29,7 +29,7 @@
 
 #include "detect_os.h"
 
-#if DETECT_OS_POSIX_LITE
+#if DETECT_OS_POSIX_LITE && !DETECT_OS_KOSMOS
 #include <dlfcn.h>
 #endif
 #if DETECT_OS_WINDOWS
@@ -44,7 +44,7 @@
 struct util_dl_library *
 util_dl_open(const char *filename)
 {
-#if DETECT_OS_POSIX_LITE
+#if DETECT_OS_POSIX_LITE && !DETECT_OS_KOSMOS
    return (struct util_dl_library *)dlopen(filename, RTLD_LAZY | RTLD_LOCAL);
 #elif DETECT_OS_WINDOWS
    return (struct util_dl_library *)LoadLibraryA(filename);
@@ -58,7 +58,7 @@
 util_dl_get_proc_address(struct util_dl_library *library,
                          const char *procname)
 {
-#if DETECT_OS_POSIX_LITE
+#if DETECT_OS_POSIX_LITE && !DETECT_OS_KOSMOS
    return (util_dl_proc) pointer_to_func(dlsym((void *)library, procname));
 #elif DETECT_OS_WINDOWS
    return (util_dl_proc)GetProcAddress((HMODULE)library, procname);
@@ -104,7 +104,7 @@
 void
 util_dl_close(struct util_dl_library *library)
 {
-#if DETECT_OS_POSIX_LITE
+#if DETECT_OS_POSIX_LITE && !DETECT_OS_KOSMOS
    dlclose((void *)library);
 #elif DETECT_OS_WINDOWS
    FreeLibrary((HMODULE)library);
@@ -117,7 +117,7 @@
 const char *
 util_dl_error(void)
 {
-#if DETECT_OS_POSIX_LITE
+#if DETECT_OS_POSIX_LITE && !DETECT_OS_KOSMOS
    return dlerror();
 #elif DETECT_OS_WINDOWS
    return "unknown error";
