+#elif defined(__kosmos__)
+
+/* Kosmos: Nebula's futex, whose wait is bounded in scheduler ticks from
+ * now where Mesa's deadline is an instant on CLOCK_MONOTONIC - the POSIX
+ * layer's conversion, as its pthreads use. */
+#include <errno.h>
+#include <time.h>
+#include <kosmos.h>
+
+unsigned long posix_ticks_for_ns(long long ns);
+
+int futex_wake(uint32_t *addr, int32_t count)
+{
+   return (int)kosmos_futex_wake(addr, (unsigned long)count);
+}
+
+int futex_wait(uint32_t *addr, int32_t value, const struct timespec *timeout)
+{
+   unsigned long ticks = 0;
+   if (timeout) {
+      struct timespec now;
+      clock_gettime(CLOCK_MONOTONIC, &now);
+      long long ns = (long long)(timeout->tv_sec - now.tv_sec) * 1000000000LL +
+                     (timeout->tv_nsec - now.tv_nsec);
+      if (ns <= 0) {
+         errno = ETIMEDOUT;
+         return -1;
+      }
+      ticks = posix_ticks_for_ns(ns);
+   }
+   long r = kosmos_futex_wait(addr, (uint32_t)value, ticks);
+   if (r == SYS_TIMED_OUT) {
+      errno = ETIMEDOUT;
+      return -1;
+   }
+   if (r == SYS_NO_CHANGE) {
+      errno = EAGAIN;
+      return -1;
+   }
+   return 0;
+}
