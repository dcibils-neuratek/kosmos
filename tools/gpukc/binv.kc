// testing.md 18.704: run on the M700 as `gpu kc /Temporary/binv.kc 16384`.
const int n;
buffer out;

void main() {
  int i = group_x * simd + lane;
  if (i < n) {
    float x = float(i) + 1.0;
    for (int k = 0; k < 1000; k += 1) { x = 1.0 / x; }
    store(out, i * 4, x);
  }
}
