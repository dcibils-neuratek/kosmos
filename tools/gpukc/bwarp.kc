// testing.md 18.704: run on the M700 as `gpu kc /Temporary/bwarp.kc 16384`.
const int n;
buffer out;

void main() {
  int i = group_x * simd + lane;
  if (i < n) {
    int s = 0;
    for (int k = 0; k < 1000; k += 1) { s = s + loadi(out, ((group_x * 16 + (k & 7)) * 4) & 65535); }
    if (s == 12345) { store(out, i * 4, s); }
  }
}
