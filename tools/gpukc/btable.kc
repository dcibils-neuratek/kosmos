// testing.md 18.705: bindep's loads from a table, through the sampler - every
// thread reading one line. Run on the M700 as `gpu kc /Temporary/btable.kc 16384`.
const int n;
buffer out;
table tab;

void main() {
  int i = group_x * simd + lane;
  if (i < n) {
    int s = 0;
    for (int k = 0; k < 1000; k += 1) { s = s + loadi(tab, (k & 7) * 4); }
    store(out, i * 4, s);
  }
}
