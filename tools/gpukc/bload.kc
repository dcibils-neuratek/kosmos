// testing.md 18.704: run on the M700 as `gpu kc /Temporary/bload.kc 16384`.
const int n;
buffer out;

void main() {
  int i = group_x * simd + lane;
  if (i < n) {
    int p = (i & 7) * 4;
    for (int k = 0; k < 1000; k += 1) { p = loadi(out, p) & 28; }
    store(out, i * 4, p);
  }
}
