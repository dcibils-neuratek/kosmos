# Sakura: cherry blossom in April. A light look whose desk is the pink of
# the petals and whose windows are the white of them, its one colour a
# deep rose.
#
# One of five looks added on 8 October 2026 - Diego: "add 5 more theme
# colors, 3 dark ones and 2 light ones with different tones that make the
# desktop look cool. create the names as well for those". Built as Night
# is: flat, a title bar on every window, three steps of surface and one
# colour, and what is written on that colour dark enough to read.

name       = sakura
flat       = yes
title_bars = yes

desktop    = #e7a9bd
window     = #fbf6f7
raised     = #ffffff
sunken     = #ffffff

line       = #e3cdd3
line_soft  = #f0e1e5
track      = #e6d3d8
swatch     = #f2b8c9

edge_light = #ffffff
edge_dark  = #e6d3d8

text       = #2b1a20
text_dim   = #7f6870
text_on    = #ffffff

tab        = #f6d4de
tab_idle   = #efe2e6
tab_text   = #5a1e33
desktop_text = #ffffff
console    = #2b1a20
console_text = #fbf6f7

accent     = #c2325f
good       = #2e9d62
bad        = #d0242f
ring       = #c2325f
stamp      = #f2c3d1

# Plex's faces at the sizes the fixed layout holds (`theme.lua`), as every
# look has them.
font.title   = ibmplexsans-semibold 18
font.ui      = ibmplexsans 18
font.heading = ibmplexsans-semibold 18
font.text    = ibmplexsans 18
font.mono    = ibmplexmono 16
font.label   = ibmplexsans-medium 18
