/*
 * How fast the GPU reads memory, and nothing else (Xavier on Vulkan, V7):
 * a buffer read sixteen bytes a load, each lane stepping by the whole
 * dispatch so neighbouring lanes read neighbouring bytes, and the words
 * folded by xor so the compiler cannot drop the loads. One word a lane is
 * written, which is nothing beside what is read. The products' shaders
 * are judged against what this reaches on the same buffer.
 */

layout(local_size_x_id = 0) in;

layout(binding = 0) readonly buffer A { uvec4 a[]; };
layout(binding = 1) writeonly buffer D { uint d[]; };

layout(push_constant) uniform P { uint n; } p;      /* the buffer, in uvec4s */

void main()
{
    const uint stride = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
    uvec4 s = uvec4(0);

    for (uint i = gl_GlobalInvocationID.x; i < p.n; i += stride) {
        s ^= a[i];
    }
    d[gl_GlobalInvocationID.x] = s.x ^ s.y ^ s.z ^ s.w;
}
