//
// **The Vulkan Kit's compute, held** (`docs/xavier.md` X12 V1): two passes
// over words, exact in integers, so the caller can work out every one.
// Pass 0: out[i] = in[i] * mul + ADD. Pass 1: out[i] = in[(i * 7 + 3) % n]
// ^ (in[i] >> 3) - each word read from another workgroup's, so it holds
// only if the barrier between the passes does. The workgroup's size and
// ADD are specialisation constants, n, mul and the pass push constants, and
// the buffers given as each dispatch is recorded: what llama.cpp's shaders
// are handed, every way they are handed it. And a byte and a half-word read
// from storage, as their blocks are.

#version 450
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require

layout(local_size_x_id = 0) in;
layout(constant_id = 1) const uint ADD = 0;

layout(push_constant) uniform Push { uint n; uint mul; uint pass; } p;

layout(binding = 0) readonly buffer In { uint in_[]; };
layout(binding = 1) writeonly buffer Out { uint out_[]; };
layout(binding = 2) readonly buffer Bytes { uint8_t bytes[]; };
layout(binding = 3) readonly buffer Halves { uint16_t halves[]; };

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) {
        return;
    }
    if (p.pass == 0) {
        out_[i] = in_[i] * p.mul + ADD + uint(bytes[i % 256]) + (uint(halves[i % 256]) << 8);
    } else {
        out_[i] = in_[(i * 7 + 3) % p.n] ^ (in_[i] >> 3);
    }
}
