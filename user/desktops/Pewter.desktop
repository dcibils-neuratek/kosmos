# Pewter: Astra in Mac OS 9.2's manner, reimagined for 2026 - a menu bar
# across the top, Platinum windows, the Control Strip (`docs/pewter.md`).
#
# Being built, a step at a time (P1 to P6): each step changes what this
# file names rather than how a desktop is chosen. `desktop:pewter` is
# Tracker's desktop in Mac OS's arrangement, its folders spatial (P4).

name       = Pewter
says       = One menu bar for everything, and Platinum - being built
shell      = notifications, desktop:pewter, menubar
background = notifications
chrome     = platinum
menus      = screen
# Its style (`desktops.lua`, M.STYLE): bevelled, since "Platinum's bevels
# are part of the desktop rather than a colour on it" (`docs/pewter.md`),
# a title bar's room kept, and the kit's shadow; none of Starlight's.
cut        = no
star       = no
plate      = no
flat       = no
title_bars = yes
shadow     = 14
