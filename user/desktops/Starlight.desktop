# Starlight: Astra with an identity of its own (`docs/astra.md`, *Identity*,
# agreed 17 November 2026 - Diego: "yes to starlight but dont replace the
# current astra one, just add starlight to the desktop styles in
# preferences").
#
# Astra's programs - the Deskbar, the dock, the launcher pad - in
# Starlight's look, with the window in front's title on an amber plate the
# window manager draws (`chrome = starlight`). The keys are Astra.desktop's,
# and `look`: the look this desktop wears, from `user/themes`.

name       = Starlight
says       = Astra in night indigo, the window in front on an amber plate
shell      = notifications, desktop, deskbar
background = notifications
chrome     = starlight
menus      = window
look       = starlight
# Its style (`desktops.lua`, M.STYLE): what floats cut at its top-left, the
# star, and the window in front's title on an amber plate - the desktop's,
# whichever look it wears - flat, a window's header its title bar, and a
# shadow reaching 24.
cut        = yes
star       = yes
plate      = yes
flat       = yes
title_bars = no
shadow     = 24
